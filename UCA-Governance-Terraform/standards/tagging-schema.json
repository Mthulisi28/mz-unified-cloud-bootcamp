  "title": "UCAMetadataTaggingSchema",
  "type": "object",
  "required": ["Environment", "Owner", "GovernanceFramework", "AutomatedOperatorControlled"],
  "properties": {
    "Environment": {
      "type": "string",
      "enum": ["dev", "test", "prod"]
    },
    "Owner": {
      "type": "string",
      "const": "Mthulisi Zulu"
    },
    "GovernanceFramework": {
      "type": "string",
      "const": "Unified Control Architecture"
    },
    "AutomatedOperatorControlled": {
      "type": "string",
      "const": "true"
    }
  }
}
